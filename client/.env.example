# CineTrack Client Environment Configuration Template
# In development:
VITE_API_URL=http://localhost:5000/api

# In production behind an Nginx reverse-proxy on the same domain (recommended):
# Leave empty or set to /api so requests are routed to the same origin:
# VITE_API_URL=/api

# In production with separate API backend (split-origin):
# Set to the full backend HTTPS URL:
# VITE_API_URL=https://api.yourdomain.com/api
