datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum CollectionVisibility {
  PRIVATE
  PUBLIC_LINK
}

enum MediaType {
  MOVIE
  TV
}

enum WatchStatus {
  TO_WATCH
  WATCHED
}

enum MemberRole {
  MEMBER
  ADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collections           Collection[]              @relation("OwnedCollections")
  collectionMemberships CollectionMember[]
  sentInvitations       CollaborationInvitation[] @relation("SentInvitations")
  receivedInvitations   CollaborationInvitation[] @relation("ReceivedInvitations")
  sessions              Session[]
  addedMovies           CollectionMovie[]

  @@index([email])
  @@index([username])
}

model Movie {
  id               String    @id @default(uuid())
  tmdbId           Int
  mediaType        MediaType @default(MOVIE)
  title            String
  originalTitle    String?
  overview         String?
  posterPath       String?
  backdropPath     String?
  releaseDate      String?
  releaseYear      Int?
  originalLanguage String?
  popularity       Float?
  voteAverage      Float?
  genres           Json      @default("[]")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  collectionMovies CollectionMovie[]

  @@unique([tmdbId, mediaType])
  @@index([tmdbId, mediaType])
  @@index([mediaType])
}

model Collection {
  id                 String               @id @default(uuid())
  ownerId            String
  title              String
  description        String?
  visibility         CollectionVisibility @default(PRIVATE)
  shareToken         String?              @unique
  isDefaultWatchlist Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  owner       User                      @relation("OwnedCollections", fields: [ownerId], references: [id], onDelete: Cascade)
  movies      CollectionMovie[]
  members     CollectionMember[]
  invitations CollaborationInvitation[]

  @@index([ownerId])
  @@index([visibility, shareToken])
}

model CollectionMovie {
  id           String      @id @default(uuid())
  collectionId String
  movieId      String
  addedBy      String
  status       WatchStatus @default(TO_WATCH)
  watchedAt    DateTime?
  note         String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  movie      Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  adder      User       @relation(fields: [addedBy], references: [id], onDelete: Cascade)

  @@unique([collectionId, movieId])
  @@index([collectionId])
  @@index([movieId])
  @@index([status])
}

model CollectionMember {
  id           String     @id @default(uuid())
  collectionId String
  userId       String
  role         MemberRole @default(MEMBER)
  joinedAt     DateTime   @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([collectionId, userId])
  @@index([collectionId])
  @@index([userId])
}

model CollaborationInvitation {
  id           String           @id @default(uuid())
  collectionId String
  inviterId    String
  inviteeId    String
  status       InvitationStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  respondedAt  DateTime?
  updatedAt    DateTime         @updatedAt

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  inviter    User       @relation("SentInvitations", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee    User       @relation("ReceivedInvitations", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([inviteeId, status])
  @@index([inviterId])
}

model Session {
  id                    String    @id @default(uuid())
  userId                String
  tokenHash             String    @unique
  previousTokenHash     String?
  historicalTokenHashes String[]  @default([])
  userAgent             String?
  ipAddress             String?
  expiresAt             DateTime
  revokedAt             DateTime?
  rotatedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([previousTokenHash])
}
