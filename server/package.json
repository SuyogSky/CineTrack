{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:server": "tsc",
    "build:scripts": "tsc -p tsconfig.scripts.json",
    "build": "tsc && tsc -p tsconfig.scripts.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:preflight": "tsx scripts/migration_preflight.ts",
    "test:e2e-recovery": "tsx scripts/test_e2e_recovery.ts",
    "db:test-backup": "tsx scripts/test_backup_restore.ts \"postgresql://cinetrack:cinetrack123@localhost:5432/cinetrack_test?schema=public\"",
    "backup:create": "tsx scripts/backup_production.ts",
    "backup:validate": "tsx scripts/backup_production.ts --validate",
    "backup:worker": "tsx scripts/backup_production.ts --schedule",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
