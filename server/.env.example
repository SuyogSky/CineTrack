# CineTrack Server Environment Configuration Template
PORT=5000
NODE_ENV=development

# Database Connections
DATABASE_URL="postgresql://user:password@localhost:5432/cinetrack?schema=public"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/cinetrack_test?schema=public"
EXPECTED_TEST_DATABASE_NAME="cinetrack_test"

# Dedicated Backup/Restore Test Configuration (Fail-closed isolation)
BACKUP_TEST_SOURCE_URL="postgresql://user:password@localhost:5432/cinetrack_test?schema=public"
BACKUP_TEST_RESTORE_DATABASE_PREFIX="cinetrack_restore_"

# Production Secrets (Must be distinct, >= 32 characters, non-placeholder in production)
JWT_ACCESS_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"
JWT_REFRESH_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"
CSRF_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"

# Network & CORS Configuration
TRUST_PROXY="false"
CORS_ORIGIN="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173"

# Cookie Configuration
# COOKIE_SAMESITE: 'lax' (recommended for same-domain or reverse-proxy deployments) or 'none' (for cross-domain deployments, requires HTTPS)
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# External TMDb API
TMDB_API_KEY="your_tmdb_api_key_v3_or_read_access_token"
TMDB_BASE_URL="https://api.themoviedb.org/3"
